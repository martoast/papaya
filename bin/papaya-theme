#!/usr/bin/env bash
# papaya-theme: make and switch Papaya themes. Changes show up live in every
# Papaya tab your person has open; nobody has to reload anything.
#
#   papaya-theme list                    themes, and which one is on
#   papaya-theme new <name> [dir]        start a theme: writes <dir>/theme.json + scene.js
#   papaya-theme push <dir>              upload theme.json (+ scene.js), switch to it,
#                                        and report whether the scene runs in the browser
#   papaya-theme use <name>|default      switch themes
#   papaya-theme status [name]           is the scene running, at what fps, or its error
#   papaya-theme pull <name> [dir]       download a theme to edit (built-ins too)
#   papaya-theme cue <name>              fire a moment scenes react to (e.g. merged)
#   papaya-theme rm <name>               delete a theme
#   papaya-theme omarchy                 list Omarchy's themes (github.com/omacom/omarchy)
#   papaya-theme omarchy <name|dir> [--wallpaper N|--no-wallpaper] [--as name]
#                                        import an Omarchy theme: palette + wallpaper
#
# A theme is a folder with theme.json (colours) and an optional scene.js (an
# animated backdrop). The format and the scene API: skills/papaya-theme/SKILL.md.
# Needs only bash and curl. Server: $PAPAYA_URL, e.g. https://papaya.your-tailnet.ts.net
set -euo pipefail

# PAPAYA_URL, else the address the installer saved.
URL=${PAPAYA_URL:-$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/papaya/url" 2>/dev/null || true)}
URL=${URL%/}
usage() { sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }
die() { echo "papaya-theme: $*" >&2; exit 1; }
need_url() { [ -n "$URL" ] || die "set PAPAYA_URL to your Papaya address, e.g. https://papaya.your-tailnet.ts.net"; }

api() { # method path [file|-] [content-type]
	local out code
	need_url
	if [ $# -ge 3 ]; then
		out=$(curl -sS --max-time 30 -X "$1" -H "Content-Type: ${4:-application/json}" --data-binary "@$3" -w '\n%{http_code}' "$URL$2") || die "cannot reach $URL (is Tailscale on?)"
	else
		out=$(curl -sS --max-time 30 -X "$1" -w '\n%{http_code}' "$URL$2") || die "cannot reach $URL (is Tailscale on?)"
	fi
	code=${out##*$'\n'}; out=${out%$'\n'*}
	if [ "${code:0:1}" != 2 ]; then
		err=$(printf '%s' "$out" | sed -n 's/.*"error":"\(.*\)".*/\1/p' | sed 's/\\"/"/g')
		die "${err:-HTTP $code}"
	fi
	printf '%s' "$out"
}

name_ok() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]] || die "theme name '$1': lowercase letters, digits and dashes (e.g. koi-pond)"; }

# status NAME [WAIT]: print what the browsers saw. Waits up to WAIT seconds for
# a running/error report. Exits 1 if the scene failed.
status() {
	local out i
	for ((i = 0; i <= ${2:-0}; i++)); do
		out=$(api GET "/api/themes/$1/status?format=text")
		grep -q '^scene:   waiting' <<<"$out" || break
		[ "$i" -lt "${2:-0}" ] && sleep 1
	done
	printf '%s\n' "$out"
	! grep -q '^scene:   ERROR' <<<"$out"
}

active() { api GET '/api/themes?format=text' | sed -n '1s/^on: //p'; }

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
	-h|--help|help|"") usage 0 ;;

	list|ls)
		api GET '/api/themes?format=text'
		;;

	new)
		[ $# -ge 1 ] || usage
		name=$1; name_ok "$name"; dir=${2:-./$name}
		[ -e "$dir/theme.json" ] && die "$dir/theme.json already exists"
		mkdir -p "$dir"
		cat >"$dir/theme.json" <<JSON
{
  "name": "$name",
  "description": "",
  "opacity": 0.8,
  "colors": {
    "surface-0": "#0d1117",
    "surface-1": "#161b22",
    "surface-2": "#21262d",
    "surface-3": "#30363d",
    "text-hi": "#e6edf3",
    "text-lo": "#8b949e",
    "accent": "#58a6ff",
    "term-bg": "#0d1117",
    "term-fg": "#e6edf3",
    "term-cursor": "#58a6ff",
    "term-sel": "#264f78"
  }
}
JSON
		cat >"$dir/scene.js" <<'JS'
// A Papaya scene: drawn behind the terminals, in a sandboxed frame.
// API: skills/papaya-theme/SKILL.md. Delete this file for a colours-only theme.
papaya.scene({
  setup(s) {
    s.state.dots = Array.from({ length: 120 }, () => ({ x: Math.random(), y: Math.random(), r: 1 + Math.random() * 2 }))
  },
  draw(s) {
    const { ctx, w, h, t } = s
    ctx.fillStyle = s.color('surface-0')
    ctx.fillRect(0, 0, w, h)
    ctx.fillStyle = s.color('accent', 0.5)
    for (const d of s.state.dots) {
      const y = (d.y + t * 0.02 * d.r) % 1
      ctx.fillRect(d.x * w, y * h, d.r, d.r)
    }
  },
  on(s, ev) {
    // ev.type: tab-open, tab-close, tab-rename, focus, activity, bell, say, cue
  },
})
JS
		echo "wrote $dir/theme.json and $dir/scene.js — edit them, then: papaya-theme push $dir"
		;;

	push)
		[ $# -ge 1 ] || usage
		dir=${1%/}
		[ -f "$dir/theme.json" ] || die "$dir/theme.json not found"
		name=$(sed -n 's/^[[:space:]]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/theme.json" | head -1)
		[ -n "$name" ] || name=$(basename "$dir")
		name_ok "$name"
		api PUT "/api/themes/$name" "$dir/theme.json" >/dev/null
		if [ -f "$dir/scene.js" ]; then
			api PUT "/api/themes/$name/scene" "$dir/scene.js" text/javascript >/dev/null
		else
			# A theme pushed without scene.js has no scene, even if it had one.
			printf '' | api PUT "/api/themes/$name/scene" - text/javascript >/dev/null
		fi
		img=""
		for f in "$dir"/background.webp "$dir"/background.png "$dir"/background.jpg "$dir"/background.jpeg; do
			if [ -f "$f" ]; then img=$f; break; fi
		done
		if [ -n "$img" ]; then
			api PUT "/api/themes/$name/image" "$img" application/octet-stream >/dev/null
		else
			printf '' | api PUT "/api/themes/$name/image" - application/octet-stream >/dev/null
		fi
		printf '{"name":"%s"}' "$name" | api POST /api/themes/active - >/dev/null
		echo "pushed $name and switched to it."
		if [ -f "$dir/scene.js" ] || [ -n "$img" ]; then status "$name" 8; else status "$name"; fi
		;;

	use)
		[ $# -ge 1 ] || usage
		[ "$1" = default ] || name_ok "$1"
		printf '{"name":"%s"}' "$1" | api POST /api/themes/active - >/dev/null
		echo "switched to $1."
		;;

	status)
		name=${1:-$(active)}
		[ "$name" = default ] && { echo "theme: default (Papaya's plain look, no scene)"; exit 0; }
		name_ok "$name"
		status "$name"
		;;

	pull)
		[ $# -ge 1 ] || usage
		name=$1; name_ok "$name"; dir=${2:-./$name}
		mkdir -p "$dir"
		out=$(api GET "/api/themes/$name")
		command -v python3 >/dev/null || die "pull needs python3 to unpack the theme"
		printf '%s' "$out" | python3 -c '
import json, sys, os
t = json.load(sys.stdin); d = sys.argv[1]
scene = t.pop("scene", "")
for k in ("updated", "builtin"): t.pop(k, None)
open(os.path.join(d, "theme.json"), "w").write(json.dumps(t, indent=2) + "\n")
if scene: open(os.path.join(d, "scene.js"), "w").write(scene)
' "$dir"
		echo "wrote $dir/theme.json$([ -f "$dir/scene.js" ] && echo " and $dir/scene.js")"
		;;

	cue)
		[ $# -ge 1 ] || usage
		printf '{"name":"%s"}' "${1//\"/}" | api POST /api/themes/cue - >/dev/null
		echo "cued $1."
		;;

	rm)
		[ $# -ge 1 ] || usage
		name_ok "$1"
		api DELETE "/api/themes/$1" >/dev/null
		echo "removed $1."
		;;

	omarchy)
		OM=https://raw.githubusercontent.com/omacom/omarchy/quattro/themes
		OMAPI="https://api.github.com/repos/omacom/omarchy/contents/themes"
		if [ $# -eq 0 ]; then
			echo "Omarchy themes (github.com/omacom/omarchy, MIT). Import one with: papaya-theme omarchy <name>"
			curl -fsS --max-time 20 "$OMAPI?ref=quattro" | grep '"name"' | sed 's/.*"name": *"\([^"]*\)".*/  \1/' || die "cannot reach GitHub"
			exit 0
		fi
		src=$1; shift
		wall=1 as=""
		while [ $# -gt 0 ]; do
			case $1 in
				--wallpaper) wall=${2:?--wallpaper needs a number}; shift 2 ;;
				--no-wallpaper) wall=0; shift ;;
				--as) as=${2:?--as needs a name}; shift 2 ;;
				*) usage ;;
			esac
		done
		tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
		if [ -d "$src" ]; then
			# A local Omarchy theme folder (e.g. ~/.config/omarchy/themes/<name>).
			[ -f "$src/colors.toml" ] || die "$src has no colors.toml"
			cp "$src/colors.toml" "$tmp/colors.toml"
			name=${as:-$(basename "${src%/}")}
			if [ "$wall" != 0 ] && [ -d "$src/backgrounds" ]; then
				pic=$(find "$src/backgrounds" -maxdepth 1 -type f | sort | sed -n "${wall}p")
				[ -n "$pic" ] && cp "$pic" "$tmp/wall"
			fi
		else
			name=${as:-$src}
			curl -fsS --max-time 20 -o "$tmp/colors.toml" "$OM/$src/colors.toml" ||
				die "Omarchy has no theme called '$src' (papaya-theme omarchy lists them)"
			if [ "$wall" != 0 ]; then
				pic=$(curl -fsS --max-time 20 "$OMAPI/$src/backgrounds?ref=quattro" 2>/dev/null |
					grep '"name"' | sed 's/.*"name": *"\([^"]*\)".*/\1/' | sort | sed -n "${wall}p")
				if [ -n "$pic" ]; then
					echo "downloading wallpaper $pic from Omarchy…"
					curl -fsS --max-time 120 -o "$tmp/wall" "$OM/$src/backgrounds/$pic" || pic=""
				fi
			fi
		fi
		name_ok "$name"
		title=$(printf '%s' "${src%/}" | sed 's#.*/##; s/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)} 1')
		api POST "/api/themes/$name/omarchy?title=$(printf '%s' "$title" | sed 's/ /%20/g')" "$tmp/colors.toml" text/plain >/dev/null
		if [ -s "$tmp/wall" ]; then
			api PUT "/api/themes/$name/image" "$tmp/wall" application/octet-stream >/dev/null ||
				echo "papaya-theme: the wallpaper was not accepted; keeping the colours" >&2
		elif [ "$wall" = 0 ]; then
			printf '' | api PUT "/api/themes/$name/image" - application/octet-stream >/dev/null
		fi
		printf '{"name":"%s"}' "$name" | api POST /api/themes/active - >/dev/null
		echo "imported Omarchy's $title as $name and switched to it."
		if [ -s "$tmp/wall" ]; then status "$name" 8; else status "$name"; fi
		;;

	*) usage ;;
esac
