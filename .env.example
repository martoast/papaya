# OPTIONAL. Papaya needs no settings at all: start it, open the "Sign in with
# Tailscale" link it prints, and finish in the setup screen. This file is for
# automated or shared installs. Every line below may be left out.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env && chmod 600 .env
#
# Secrets belong here rather than in a shell command, where they end up in
# ~/.zsh_history and in the process list for every other user on the machine.

# Optional: join without the browser sign-in.
# Generated at https://login.tailscale.com/admin/settings/keys
#
# It must be REUSABLE and NON-EPHEMERAL.
#
# Reusable: an ephemeral node deregisters itself when the process stops, which
# invalidates its stored state, so every restart re-enrols and needs the key
# again. A single-use key therefore only ever starts once.
#
# Non-ephemeral: the key decides this, not PAPAYA_EPHEMERAL below. An ephemeral
# key produces an ephemeral node however that is set, and the control plane
# reaps ephemeral nodes after they have been offline a while — so the node
# survives ordinary restarts, then comes back with a new address after one long
# outage. Confirm in the admin console that the node is not tagged "Ephemeral".
TS_AUTHKEY=

# https://platform.openai.com/api-keys — omit to disable voice input.
PAPAYA_OPENAI_API_KEY=

# --- identity: who may use the web terminal ---
# Leave empty for "only the account papaya is signed in with".
PAPAYA_ALLOWED_USERS=you@example.com

# --- reach: where sessions may go, and as whom ---
# Both are enforced server-side. Without them the tailnet ACL is the only limit.
PAPAYA_ALLOWED_HOSTS=devbox-1,laptop
PAPAYA_ALLOWED_SSH_USERS=ubuntu
# The account to log in as on every host. There is no built-in default.
# A host that needs a different one: write it as user@host in PAPAYA_HOSTS.
PAPAYA_SSH_USER=ubuntu
PAPAYA_HOSTS=devbox-1,laptop

# --- the rest ---
PAPAYA_HOSTNAME=papaya
PAPAYA_TLS=true

# false keeps one permanent node with a stable address. An ephemeral node
# deregisters on every stop, which changes the address and leaves the local DNS
# cache stale until it is flushed. The cost is that the node stays listed while
# papaya is not running.
PAPAYA_EPHEMERAL=false

# To serve under your own domain, point an A record at this node's 100.x address
# and supply a certificate for that name (Tailscale only issues for *.ts.net).
# The certificate must come from a DNS-01 challenge: the node is not reachable
# from the public internet, so HTTP-01 cannot work.
# PAPAYA_TLS_CERT=./deploy/term.example.com.crt
# PAPAYA_TLS_KEY=./deploy/term.example.com.key

# Run each remote shell inside a named tmux session, keyed on the tab name, so
# work survives papaya restarting and the machine sleeping. Falls back to a
# login shell on hosts without tmux.
PAPAYA_TMUX=true
# Durable, not /tmp: macOS prunes /tmp, and losing this directory means the node
# re-registers and the cached TLS certificate is re-issued from scratch.
PAPAYA_STATE_DIR=./deploy/state
PAPAYA_KNOWN_HOSTS=./deploy/known_hosts
