bin/
web/dist/*
!web/dist/.gitkeep
web/node_modules/
web/test-results/
web/playwright-report/

# Generated at test time; never commit a private key, even a disposable one.
test/keys/

deploy/known_hosts

.DS_Store
*.log

# Secrets. Never commit.
.env
# Timestamped copies left behind by hand-editing the file. These hold the same
# auth key and API key the real one does, and ".env" alone does not cover them:
# four of them sat untracked in this directory for weeks, one `git add -A` away
# from being published.
.env.bak*
deploy/.env
deploy/state/
deploy/.cloudflare
deploy/certs/

# Private key for hosts that cannot run Tailscale SSH (macOS targets).
deploy/id_papaya
deploy/id_papaya.pub
deploy/known_hosts.bak
